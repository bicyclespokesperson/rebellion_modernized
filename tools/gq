#!/usr/bin/env python3
"""Ghidra query client. Usage:
  gq 'print(decomp(0x401000))'      run a snippet
  gq -f script.py                    run a file
  gq --save | --quit                 persist / stop the server
"""
import json, socket, sys
from pathlib import Path

sock_path = Path(__file__).resolve().parent.parent / "work" / "ghidra.sock"
args = sys.argv[1:]
if args and args[0] == "--save":
    req = {"cmd": "save"}
elif args and args[0] == "--quit":
    req = {"cmd": "quit"}
elif args and args[0] == "-f":
    req = {"code": Path(args[1]).read_text()}
else:
    req = {"code": args[0] if args else sys.stdin.read()}
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.connect(str(sock_path))
s.sendall(json.dumps(req).encode() + b"\n\0")
s.shutdown(socket.SHUT_WR)
chunks = []
while chunk := s.recv(65536):
    chunks.append(chunk)
sys.stdout.write(b"".join(chunks).decode(errors="replace"))
