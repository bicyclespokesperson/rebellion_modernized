# Native Linux x86-64 build (REB_NATIVE, tools/build_native.sh): the compilers, what SDL3 (built from the pinned source)
# needs for its X11/Wayland/audio backends, Xvfb and xdotool for the scenario runs (tools/run_native.sh), and what the
# sanitizer builds need. Build: tools/build_native.sh --image
# (DOCKER_BUILDKIT=0 docker build -t rebellion-native -f docker/Dockerfile.native docker).
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      clang lld llvm clang-19 lld-19 llvm-19 cmake ninja-build make python3 python3-pip python3-venv \
      xvfb xauth x11-utils xdotool imagemagick ca-certificates curl xz-utils unzip procps \
    && rm -rf /var/lib/apt/lists/*
RUN printf 'pcm.!default { type plug slave.pcm "nullout" }\npcm.nullout { type null }\n' > /etc/asound.conf
WORKDIR /work
RUN apt-get update && apt-get install -y --no-install-recommends \
      libx11-dev libxext-dev libxcursor-dev libxi-dev libxfixes-dev libxrandr-dev libxss-dev libxkbcommon-dev \
      libwayland-dev wayland-protocols libdecor-0-dev libasound2-dev libpulse-dev libdrm-dev libgbm-dev libgl1-mesa-dev \
      libegl1-mesa-dev libudev-dev libdbus-1-dev pkg-config libclang-rt-19-dev libxcb1-dev gdb valgrind \
    && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends libxtst-dev libxrender-dev libxkbcommon-x11-dev \
    && rm -rf /var/lib/apt/lists/*
# Python helpers that run in the container: tools/find_float_casts.py asks libclang for the conversions in src/.
RUN apt-get update && apt-get install -y --no-install-recommends python3-pefile python3-clang-19 libclang-19-dev git \
    && rm -rf /var/lib/apt/lists/*
# aarch64 cross build and qemu-user (docs/native.md): the arm64 readiness check of the native build (tools/build_native.sh --arch arm64).
RUN apt-get update && apt-get install -y --no-install-recommends gcc-13-aarch64-linux-gnu g++-13-aarch64-linux-gnu \
      libc6-dev-arm64-cross libstdc++-13-dev-arm64-cross qemu-user \
    && rm -rf /var/lib/apt/lists/*
